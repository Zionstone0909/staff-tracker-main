# This file serves as a template for your actual .env file.
# Copy this content to a new file named .env (without the .example extension)
# and replace the placeholder values with your real credentials.

# ================================
# 🔥 Supabase Configuration
# ================================
# Required by lib/supabase.ts

# Your Supabase Project URL.
VITE_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL_HERE"

# Your Supabase Anon Public Key.
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"


# ================================
# 🔥 Firebase Configuration
# ================================
# Required if using Firebase Auth / Firestore (src/firebase.ts)

VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"


# ================================
# Optional App Config
# ================================

# Example base API URL
# VITE_API_BASE_URL="http://localhost:3000/api"

# App Name
VITE_APP_NAME="Staff Tracker"
